{
  "app-id": "dev.mooday.GstPipelineStudio",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "gst-pipeline-studio",
  "finish-args": [
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=shm",
    "--device=all",
    "--share=ipc",
    "--share=network",
    "--env=G_MESSAGES_DEBUG=none"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "*.la",
    "*.a"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "modules": [
    {
      "name": "gst-pipeline-studio",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "archive",
          "url": "https://gitlab.freedesktop.org/-/project/12908/uploads/ec5bcb64ec62931b2f7b96642317f2aa/gst-pipeline-studio-0.7.0.tar.xz",
          "sha256": "bfcf4a3bee0d5907fdffd7811895c1c4f17dcc57e8edcbeabc62374ce8391789"
        }
      ]
    }
  ]
}